@model UsuarioFormDto
@{
    var esNuevo = ViewBag.EsNuevo == true;
}
<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">@(esNuevo ? "Nuevo Usuario" : "Editar Usuario")</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="formUsuario"
      asp-action="@(esNuevo ? "GuardarNuevo" : "GuardarEditado")"
      asp-controller="Usuarios"
      method="post"
      onsubmit="guardarUsuario(event)">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Apellido" class="form-label"></label>
            <input asp-for="Apellido" class="form-control" />
            <span asp-validation-for="Apellido" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Dni" class="form-label"></label>
            <input asp-for="Dni" class="form-control" min="1000000" max="99999999" />
            <span asp-validation-for="Dni" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Legajo" class="form-label"></label>
            <input asp-for="Legajo" class="form-control" />
            <span asp-validation-for="Legajo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Rol" class="form-label"></label>
            <select asp-for="Rol" asp-items="ViewBag.Roles" class="form-select">
                <option value="">-- Seleccionar rol --</option>
            </select>
            <span asp-validation-for="Rol" class="text-danger"></span>
        </div>

        @if (esNuevo)
        {
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        }

        <div class="form-check form-switch">
            <input asp-for="Estado" class="form-check-input" />
            <label asp-for="Estado" class="form-check-label"></label>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Guardar
        </button>
    </div>
</form>