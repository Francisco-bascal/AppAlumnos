@model IEnumerable<UsuarioDto>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    var emailActual = User.Identity?.Name;
}

@Html.AntiForgeryToken()

<div class="text-center mb-4">
    <h2 class="mb-3">Gestión de Usuarios</h2>
    <button type="button" class="btn btn-primary"
            onclick="abrirModal('@Url.Action("ObtenerFormulario", "Usuarios")')">
        + Nuevo Usuario
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Apellido y Nombre</th>
                    <th>Email</th>
                    <th>DNI</th>
                    <th>Legajo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Fecha de alta</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var esYo = string.Equals(item.Email, emailActual, StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td class="align-middle">@item.Apellido, @item.Nombre</td>
                        <td class="align-middle">@item.Email</td>
                        <td class="align-middle">@item.Dni</td>
                        <td class="align-middle">@(string.IsNullOrEmpty(item.Legajo) || item.Legajo == "-" ? "-" : item.Legajo)</td>
                        <td class="align-middle">
                            <span class="badge @(item.Rol == "Administrador" ? "bg-danger text-white" : item.Rol == "Docente" ? "bg-info text-dark" : "bg-primary text-white")">
                                @item.Rol
                            </span>
                        </td>
                        <td class="align-middle">
                            @if (item.Estado)
                            {
                                <span class="badge bg-success text-white">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-white">Inactivo</span>
                            }
                        </td>
                        <td class="align-middle">@item.FechaAlta.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-warning me-1"
                                    @(esYo ? "disabled" : "")
                                    onclick="abrirModal('@Url.Action("ObtenerFormulario", "Usuarios", new { id = item.Id })')">
                                Editar
                            </button>
                            <button class="btn btn-sm @(item.Estado ? "btn-outline-danger" : "btn-outline-success") me-1"
                                    @(esYo ? "disabled" : "")
                                    onclick="confirmarCambioEstado('@item.Id', @(item.Estado ? "false" : "true"), '@item.Apellido, @item.Nombre')">
                                @(item.Estado ? "Desactivar" : "Activar")
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    @(esYo ? "disabled" : "")
                                    onclick="eliminarUsuario('@item.Id', '@item.Apellido, @item.Nombre')">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Contenedor del Modal Bootstrap -->
<div class="modal fade" id="modalUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalContent">
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const modalElement = new bootstrap.Modal(document.getElementById('modalUsuario'));
        const modalContent = document.getElementById('modalContent');

        // 1. Abrir Modal para Crear/Editar
        function abrirModal(url) {
            fetch(url)
                .then(res => res.text())
                .then(html => {
                    modalContent.innerHTML = html;
                    $.validator.unobtrusive.parse('#formUsuario');
                    modalElement.show();
                });
        }

        // 2. Enviar Formulario vía AJAX
        function guardarUsuario(event) {
            event.preventDefault();
            const form = event.target;

            if (!$(form).valid()) return;

            const pass = document.getElementById('Password');
            if (pass && pass.value.trim() === '') {
                Swal.fire('Aviso', 'La contraseña es obligatoria.', 'warning');
                return;
            }
            const confirm = document.getElementById('ConfirmPassword');
            if (pass && confirm && confirm.value !== pass.value) {
                Swal.fire('Aviso', 'La contraseña y su confirmación no coinciden.', 'warning');
                return;
            }

            fetch(form.action, {
                method: 'POST',
                body: new FormData(form)
            })
                .then(res => {
                    if (res.headers.get("content-type").includes("application/json")) {
                        return res.json().then(data => {
                            if (data.success) {
                                modalElement.hide();
                                location.reload();
                            } else {
                                Swal.fire('Error', data.mensaje, 'error');
                            }
                        });
                    } else {
                        return res.text().then(html => {
                            modalContent.innerHTML = html;
                            $.validator.unobtrusive.parse('#formUsuario');
                        });
                    }
                });
        }

        // 3. Activar/Desactivar vía AJAX
        function confirmarCambioEstado(id, estado, nombre) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: `¿${estado ? "Activar" : "Desactivar"} al usuario "${nombre}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, confirmar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const formData = new FormData();
                    formData.append('id', id);
                    formData.append('estado', estado);
                    if (token) formData.append('__RequestVerificationToken', token);

                    fetch('@Url.Action("CambiarEstado", "Usuarios")', {
                        method: 'POST',
                        body: formData
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire(
                                    '¡Listo!',
                                    data.mensaje,
                                    'success'
                                ).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', data.mensaje, 'error');
                            }
                        });
                }
            });
        }

        // 4. Eliminar Usuario vía AJAX
        function eliminarUsuario(id, nombre) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: `¿Estás seguro de eliminar al usuario "${nombre}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const formData = new FormData();
                    formData.append('id', id);
                    if (token) formData.append('__RequestVerificationToken', token);

                    fetch('@Url.Action("Eliminar", "Usuarios")', {
                        method: 'POST',
                        body: formData
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire(
                                    '¡Eliminado!',
                                    data.mensaje,
                                    'success'
                                ).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', data.mensaje, 'error');
                            }
                        });
                }
            });
        }
    </script>
}