@model List<AppAlumnos.Models.Cursada>
@{
    Func<AppAlumnos.Models.EstadoCursada, string> nombreEstado = e => e switch
    {
        AppAlumnos.Models.EstadoCursada.Cursando => "Cursando",
        AppAlumnos.Models.EstadoCursada.Regular => "Regular",
        AppAlumnos.Models.EstadoCursada.Aprobada => "Aprobada",
        AppAlumnos.Models.EstadoCursada.Libre => "Libre",
        AppAlumnos.Models.EstadoCursada.Desaprobada => "Desaprobada",
        _ => e.ToString()
    };
}

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h5 class="mb-0"><i class="bi bi-clipboard-data me-2 text-primary"></i>Historia académica</h5>
            <small class="text-muted">Filtra tus cursadas por año y estado.</small>
        </div>
        <div class="d-flex gap-2 align-items-end">
            <div>
                <label class="form-label small mb-0" for="filtroAnio">Año</label>
                <select id="filtroAnio" class="form-select form-select-sm" onchange="filtrarHistoria()">
                    <option value="">Todos</option>
                    @foreach (var anio in (List<int>)ViewBag.Anios)
                    {
                        <option value="@anio" selected="@(ViewBag.AnioSeleccionado != null && (int)ViewBag.AnioSeleccionado == anio)">@anio</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label small mb-0" for="filtroEstado">Estado</label>
                <select id="filtroEstado" class="form-select form-select-sm" onchange="filtrarHistoria()">
                    <option value="">Todos</option>
                    @foreach (var estado in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Estados)
                    {
                        <option value="@estado.Value" selected="@estado.Selected">@estado.Text</option>
                    }
                </select>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary"
                    onclick="window.open('@Url.Action("HistoriaImprimir", "Autogestion")', '_blank')">
                <i class="bi bi-printer me-1"></i>Imprimir
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center p-4">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <p class="mt-2 mb-0">No se encontraron cursadas para los filtros seleccionados.</p>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Materia</th>
                        <th class="text-center">Año Lectivo</th>
                        <th class="text-center">Nota</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cursada in Model)
                    {
                        <tr>
                            <td class="align-middle">@cursada.Materia.Nombre</td>
                            <td class="align-middle text-center">@cursada.AnioLectivo</td>
                            <td class="align-middle text-center">
                                @(cursada.Nota.HasValue ? cursada.Nota.Value.ToString("0.#") : "-")
                            </td>
                            <td class="align-middle text-center">
                                <span class="badge @(cursada.Estado switch
                                    {
                                        AppAlumnos.Models.EstadoCursada.Aprobada => "bg-success text-white",
                                        AppAlumnos.Models.EstadoCursada.Desaprobada or AppAlumnos.Models.EstadoCursada.Libre => "bg-danger text-white",
                                        _ => "bg-secondary text-white"
                                    })">
                                    @nombreEstado(cursada.Estado)
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>