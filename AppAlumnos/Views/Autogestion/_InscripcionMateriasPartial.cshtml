@model List<AppAlumnos.Models.Materia>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-journal-plus me-2 text-primary"></i>Inscripción a materias</h5>
        <small class="text-muted">Materias disponibles para el año lectivo @ViewBag.AnioActual.</small>
    </div>
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center p-4">
                <i class="bi bi-check-circle fs-1 text-success"></i>
                <p class="mt-2 mb-0">Ya estás inscripto/a en todas las materias del año lectivo actual.</p>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Materia</th>
                        <th class="text-center">Año</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var materia in Model)
                    {
                        <tr>
                            <td class="align-middle">@materia.Nombre</td>
                            <td class="align-middle text-center">@materia.Anio</td>
                            <td class="align-middle text-end">
                                <button type="button" class="btn btn-sm btn-primary"
                                        onclick="inscribirse(@materia.Id)">
                                    <i class="bi bi-plus-circle me-1"></i>Inscribirme
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>