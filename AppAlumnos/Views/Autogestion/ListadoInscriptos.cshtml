@model List<AppAlumnos.Models.Cursada>
@{
    ViewData["Title"] = "Listado de Inscriptos";
    Func<AppAlumnos.Models.EstadoCursada, string> nombreEstado = e => e switch
    {
        AppAlumnos.Models.EstadoCursada.Cursando => "Cursando",
        AppAlumnos.Models.EstadoCursada.Regular => "Regular",
        AppAlumnos.Models.EstadoCursada.Aprobada => "Aprobada",
        AppAlumnos.Models.EstadoCursada.Libre => "Libre",
        AppAlumnos.Models.EstadoCursada.Desaprobada => "Desaprobada",
        _ => e.ToString()
    };
    var materiaNombre = ViewBag.MateriaNombre as string;
    var cantidad = (int)ViewBag.Cantidad;
    var docenteNombre = ViewBag.DocenteNombre as string;
}

<div class="text-center mb-4">
    <h4 class="mb-1">Listado de Alumnos Inscriptos</h4>
    <p class="text-muted mb-0">Materia: <strong>@materiaNombre</strong> - @docenteNombre</p>
</div>

<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th class="text-center" style="width:50px">N°</th>
            <th>Apellido y Nombre</th>
            <th class="text-center">Nota</th>
            <th class="text-center">Estado</th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Model.Count; i++)
        {
            var cursada = Model[i];
            <tr>
                <td class="text-center">@(i + 1)</td>
                <td>@cursada.Usuario.Apellido, @cursada.Usuario.Nombre</td>
                <td class="text-center">@(cursada.Nota.HasValue ? cursada.Nota.Value.ToString("0.#") : "-")</td>
                <td class="text-center">@nombreEstado(cursada.Estado)</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="text-center text-muted">Esta materia no registra alumnos inscriptos.</p>
}

<div class="d-flex justify-content-between align-items-center small text-muted">
    <span>Total de alumnos: @cantidad</span>
    <span>Generado el @DateTime.Now.ToString("dd/MM/yyyy") - @DateTime.Now.ToString("HH:mm")</span>
</div>

@section Scripts {
    <script>
        window.print();
    </script>
}