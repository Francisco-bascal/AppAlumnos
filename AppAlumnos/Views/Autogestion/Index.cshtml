@using Microsoft.AspNetCore.Identity
@using AppAlumnos.Models
@inject UserManager<Usuario> UserManager
@{
    var esAlumno = User.IsInRole("Alumno");
    var esDocente = User.IsInRole("Docente");
    var esAdministrador = User.IsInRole("Administrador");

    ViewData["Title"] = esAdministrador ? "Panel Administrativo" : esDocente ? "Mi Gestión" : "Portal de Autogestión";
    var usuario = await UserManager.GetUserAsync(User);
}

@Html.AntiForgeryToken()

<div class="text-center mb-4">
    <h2 class="mb-1">@ViewData["Title"]</h2>
    <p class="text-muted mb-0">Hola @(usuario?.Nombre) @(usuario?.Apellido), elegí una opción para comenzar.</p>
</div>

<div class="row g-3 justify-content-center">

    @if (esAlumno)
    {
        <div class="col-sm-6 col-lg-4">
            <button type="button" class="card card-opcion text-center w-100 h-100 border-0 shadow-sm"
                    onclick="cargarPortal('@Url.Action("InscripcionMaterias", "Autogestion")')">
                <div class="card-body">
                    <i class="bi bi-journal-plus fs-1 text-primary"></i>
                    <h6 class="card-title mt-3 mb-1">Inscripción a materias</h6>
                    <small class="text-muted">Inscribite a las materias del año lectivo actual.</small>
                </div>
            </button>
        </div>
        <div class="col-sm-6 col-lg-4">
            <button type="button" class="card card-opcion text-center w-100 h-100 border-0 shadow-sm"
                    onclick="cargarPortal('@Url.Action("HistoriaAcademica", "Autogestion")')">
                <div class="card-body">
                    <i class="bi bi-clipboard-data fs-1 text-primary"></i>
                    <h6 class="card-title mt-3 mb-1">Historia académica</h6>
                    <small class="text-muted">Consultá tus cursadas, notas y estados por año.</small>
                </div>
            </button>
        </div>
        <div class="col-sm-6 col-lg-4">
            <button type="button" class="card card-opcion text-center w-100 h-100 border-0 shadow-sm"
                    onclick="cargarPortal('@Url.Action("Certificados", "Autogestion")')">
                <div class="card-body">
                    <i class="bi bi-award fs-1 text-primary"></i>
                    <h6 class="card-title mt-3 mb-1">Solicitar documentos</h6>
                    <small class="text-muted">Descargá tu certificado de alumno regular y materias aprobadas.</small>
                </div>
            </button>
        </div>
    }

    @if (esDocente)
    {
        <div class="col-sm-6 col-lg-4">
            <button type="button" class="card card-opcion text-center w-100 h-100 border-0 shadow-sm"
                    onclick="cargarPortal('@Url.Action("MisMaterias", "Autogestion")')">
                <div class="card-body">
                    <i class="bi bi-book fs-1 text-primary"></i>
                    <h6 class="card-title mt-3 mb-1">Mis materias e inscriptos</h6>
                    <small class="text-muted">Consultá tus materias y los alumnos inscriptos.</small>
                </div>
            </button>
        </div>
        <div class="col-sm-6 col-lg-4">
            <button type="button" class="card card-opcion text-center w-100 h-100 border-0 shadow-sm"
                    onclick="cargarPortal('@Url.Action("MisMaterias", "Autogestion")')">
                <div class="card-body">
                    <i class="bi bi-pencil-square fs-1 text-primary"></i>
                    <h6 class="card-title mt-3 mb-1">Cargar notas y estado</h6>
                    <small class="text-muted">Registrá calificaciones y estados de cursada.</small>
                </div>
            </button>
        </div>
        <div class="col-sm-6 col-lg-4">
            <button type="button" class="card card-opcion text-center w-100 h-100 border-0 shadow-sm"
                    onclick="cargarPortal('@Url.Action("SeleccionarListado", "Autogestion")')">
                <div class="card-body">
                    <i class="bi bi-printer fs-1 text-primary"></i>
                    <h6 class="card-title mt-3 mb-1">Listado imprimible</h6>
                    <small class="text-muted">Generá listados de inscriptos para imprimir o descargar en PDF.</small>
                </div>
            </button>
        </div>
    }

    @if (esAdministrador)
    {
        <div class="col-sm-6 col-lg-4">
            <a class="card card-opcion text-center w-100 h-100 border-0 shadow-sm text-decoration-none text-dark"
               asp-area="" asp-controller="Materias" asp-action="Index">
                <div class="card-body">
                    <i class="bi bi-journal-plus fs-1 text-primary"></i>
                    <h6 class="card-title mt-3 mb-1">Gestionar materias</h6>
                    <small class="text-muted">Alta, edición y baja de materias y asignación de docentes.</small>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-4">
            <a class="card card-opcion text-center w-100 h-100 border-0 shadow-sm text-decoration-none text-dark"
               asp-area="" asp-controller="Cursadas" asp-action="Index">
                <div class="card-body">
                    <i class="bi bi-people fs-1 text-primary"></i>
                    <h6 class="card-title mt-3 mb-1">Gestionar inscripciones</h6>
                    <small class="text-muted">Inscribí alumnos, modificá o eliminá cursadas y cargá sus notas.</small>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-4">
            <a class="card card-opcion text-center w-100 h-100 border-0 shadow-sm text-decoration-none text-dark"
               asp-area="" asp-controller="Usuarios" asp-action="Index">
                <div class="card-body">
                    <i class="bi bi-person-gear fs-1 text-primary"></i>
                    <h6 class="card-title mt-3 mb-1">Gestionar usuarios</h6>
                    <small class="text-muted">Creá usuarios, asigná roles y activá o desactivá cuentas.</small>
                </div>
            </a>
        </div>
    }

    <div class="col-sm-6 col-lg-4">
        <button type="button" class="card card-opcion text-center w-100 h-100 border-0 shadow-sm"
                onclick="cargarPortal('@Url.Action("MiPerfil", "Autogestion")')">
            <div class="card-body">
                <i class="bi bi-person-circle fs-1 text-primary"></i>
                <h6 class="card-title mt-3 mb-1">Mi perfil</h6>
                <small class="text-muted">Actualizá tu foto de perfil y consultá tus datos.</small>
            </div>
        </button>
    </div>

</div>

<div id="contenidoPortal" class="mt-4"></div>

<!-- Contenedor del Modal Bootstrap -->
<div class="modal fade" id="modalPortal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalPortalContent">
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ------------------------------------------------------------------
        // PATRÓN DEL PORTAL: partials vía AJAX + formularios parciales
        // Los partials se solicitan con fetch y se inyectan con innerHTML
        // en #contenidoPortal o en el modal. Los <script> dentro del HTML
        // insertado NO se ejecutan, por eso los partials usan únicamente
        // handlers onclick, onsubmit u onchange y todo el JS vive aquí.
        // En POST, el controlador responde JSON { success, mensaje } si
        // tiene éxito; si ModelState falla, devuelve el partial con errores
        // y el JS lo vuelve a inyectar para mostrar validaciones.
        // El token antiforgery se renderiza una vez con @Html.AntiForgeryToken()
        // (fuera de los formularios parciales) y el JS lo lee del DOM.
        // Las descargas NO usan fetch: se abren con window.open; por ello
        // los endpoints de descarga devuelven HTML (PaginaError) con código
        // HTTP 400/500 ante errores, nunca JSON. Esto evita tratar un blob
        // de error como JSON. El flujo docente evita depender de <script>
        // inyectados (ver _SeleccionarListadoPartial). La validación jQuery
        // Unobtrusive se vuelve a vincular con $.validator.unobtrusive.parse
        // cada vez que se reinyecta HTML en el modal.
        // ------------------------------------------------------------------
        const modalPortalElement = new bootstrap.Modal(document.getElementById('modalPortal'));
        const modalPortalContent = document.getElementById('modalPortalContent');

        // 1. Inyecta un partial en el área de contenido del portal
        function cargarPortal(url) {
            fetch(url)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('contenidoPortal').innerHTML = html;
                });
        }

        // 2. Inyecta un partial dentro del modal y revincula sus validaciones
        function abrirModalPortal(url, formId) {
            fetch(url)
                .then(res => res.text())
                .then(html => {
                    modalPortalContent.innerHTML = html;
                    if (formId) $.validator.unobtrusive.parse(formId);
                    modalPortalElement.show();
                });
        }

        // 3. POST genérico de formularios parciales; recarga el partial de origen al éxito
        function guardarFormularioPortal(event, urlReload) {
            event.preventDefault();
            const form = event.target;

            if (!$(form).valid()) return;

            fetch(form.action, {
                method: 'POST',
                body: new FormData(form)
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        modalPortalElement.hide();
                        Swal.fire('¡Listo!', data.mensaje, 'success');
                        cargarPortal(urlReload);
                    } else {
                        Swal.fire('Error', data.mensaje, 'error');
                    }
                });
        }

        // 4. Confirma la inscripción y envía el token antiforgery leído del DOM
        function inscribirse(materiaId) {
            Swal.fire({
                title: '¿Confirmás la inscripción?',
                text: 'Se registrará tu inscripción para el año lectivo actual.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, inscribirme',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (!result.isConfirmed) return;

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const formData = new FormData();
                formData.append('materiaId', materiaId);
                if (token) formData.append('__RequestVerificationToken', token);

                fetch('@Url.Action("Inscribirse", "Autogestion")', {
                    method: 'POST',
                    body: formData
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire('¡Inscripto!', data.mensaje, 'success');
                            cargarPortal('@Url.Action("InscripcionMaterias", "Autogestion")');
                        } else {
                            Swal.fire('Error', data.mensaje, 'error');
                        }
                    });
            });
        }

        // 5. Aplica los filtros de la historia académica recargando el partial
        function filtrarHistoria() {
            const anio = document.getElementById('filtroAnio')?.value ?? '';
            const estado = document.getElementById('filtroEstado')?.value ?? '';
            cargarPortal('@Url.Action("HistoriaAcademica", "Autogestion")' + '?anio=' + anio + '&estado=' + estado);
        }

        // 6. Guarda las notas usando el flujo genérico y vuelve a listar los inscriptos
        function guardarNotasPortal(event) {
            guardarFormularioPortal(event, '@Url.Action("Inscriptos", "Autogestion")' + '?materiaId=' + document.getElementById('materiaContexto')?.value);
        }

        // 7. Abre el formulario de notas de una cursada en el modal
        function abrirFormularioNotas(cursadaId) {
            abrirModalPortal('@Url.Action("ObtenerFormularioNotas", "Autogestion")' + '?cursadaId=' + cursadaId, '#formNotasPortal');
        }

        // 8. Abre el listado imprimible en una pestaña nueva (window.open, no fetch)
        function verListado(materiaId) {
            window.open('@Url.Action("ListadoInscriptos", "Autogestion")' + '?materiaId=' + materiaId, '_blank');
        }

        // 9. Descarga el listado en PDF abriendo la URL en una pestaña nueva
        function descargarListadoPdf(materiaId) {
            window.open('@Url.Action("DescargarListadoPdf", "Autogestion")' + '?materiaId=' + materiaId, '_blank');
        }

        // 10. Devuelve la materia elegida o null si el selector está vacío
        function materiaSeleccionada() {
            const materiaId = document.getElementById('selectMateria')?.value;
            if (!materiaId) {
                Swal.fire('Aviso', 'Seleccioná una materia.', 'warning');
                return null;
            }
            return materiaId;
        }

        // 11. Inyecta el partial de inscriptos para la materia seleccionada
        function verInscriptosDeMateriaSeleccionada() {
            const materiaId = materiaSeleccionada();
            if (materiaId) cargarPortal('@Url.Action("Inscriptos", "Autogestion")' + '?materiaId=' + materiaId);
        }

        // 12. Abre el listado imprimible de la materia seleccionada
        function verListadoDeMateriaSeleccionada() {
            const materiaId = materiaSeleccionada();
            if (materiaId) verListado(materiaId);
        }

        // 13. Descarga el PDF del listado de la materia seleccionada
        function descargarListadoPdfDeMateriaSeleccionada() {
            const materiaId = materiaSeleccionada();
            if (materiaId) descargarListadoPdf(materiaId);
        }

        // 14. Abre el certificado solicitado en una pestaña nueva
        function descargarCertificado(tipo) {
            window.open('@Url.Action("GenerarCertificado", "Autogestion")' + '?tipo=' + tipo, '_blank');
        }

        // 15. Valida el archivo en el navegador y muestra una vista previa local
        function previsualizarAvatar(input) {
            if (!input.files || !input.files[0]) return;

            const archivo = input.files[0];
            if (archivo.size > 2 * 1024 * 1024) {
                Swal.fire('Error', 'La imagen supera el tamaño máximo de 2 MB.', 'error');
                input.value = '';
                return;
            }

            const extensionesValidas = ['jpg', 'jpeg', 'png', 'webp'];
            const extension = archivo.name.split('.').pop().toLowerCase();
            if (!extensionesValidas.includes(extension)) {
                Swal.fire('Error', 'Formato no permitido. Usá JPG, PNG o WebP.', 'error');
                input.value = '';
                return;
            }

            const lector = new FileReader();
            lector.onload = function (e) {
                const img = document.getElementById('avatarPreview');
                if (img) img.src = e.target.result;
            };
            lector.readAsDataURL(archivo);
        }

        // 16. Sube el avatar con FormData y refresca la imagen con una clave anti-caché
        function subirAvatar(event) {
            event.preventDefault();
            const form = event.target;

            fetch(form.action, {
                method: 'POST',
                body: new FormData(form)
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire('¡Foto actualizada!', data.mensaje, 'success');
                        const img = document.getElementById('avatarPreview');
                        if (img && data.rutaFoto) {
                            img.src = data.rutaFoto + '?v=' + Date.now();
                        }
                        cargarPortal('@Url.Action("MiPerfil", "Autogestion")');
                    } else {
                        Swal.fire('Error', data.mensaje, 'error');
                    }
                });
        }
    </script>
}