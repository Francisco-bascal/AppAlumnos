@model List<MateriaDto>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-book me-2 text-primary"></i>Mis materias e inscriptos</h5>
        <small class="text-muted">
            Materias asignadas en tu perfil docente.
        </small>
    </div>
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center p-4">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <p class="mt-2 mb-0">No tenés materias asignadas. Contactá a la administración.</p>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Materia</th>
                        <th class="text-center">Año</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var materia in Model)
                    {
                        <tr>
                            <td class="align-middle">@materia.Nombre</td>
                            <td class="align-middle text-center">@materia.Anio</td>
                            <td class="align-middle text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                        onclick="cargarPortal('@Url.Action("Inscriptos", "Autogestion")?materiaId=@materia.Id')">
                                    <i class="bi bi-people me-1"></i>Ver inscriptos
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                        onclick="descargarListadoPdf(@materia.Id)">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>