@model List<AppAlumnos.Models.Cursada>
@{
    ViewData["Title"] = "Historia Académica";
    Func<AppAlumnos.Models.EstadoCursada, string> nombreEstado = e => e switch
    {
        AppAlumnos.Models.EstadoCursada.Cursando => "Cursando",
        AppAlumnos.Models.EstadoCursada.Regular => "Regular",
        AppAlumnos.Models.EstadoCursada.Aprobada => "Aprobada",
        AppAlumnos.Models.EstadoCursada.Libre => "Libre",
        AppAlumnos.Models.EstadoCursada.Desaprobada => "Desaprobada",
        _ => e.ToString()
    };
    var titular = ViewBag.Titular as string;
}

<div class="text-center mb-4">
    <h4 class="mb-1">Historia Académica</h4>
    <p class="text-muted mb-0">@titular</p>
</div>

<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Materia</th>
            <th class="text-center">Año Lectivo</th>
            <th class="text-center">Nota</th>
            <th class="text-center">Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cursada in Model)
        {
            <tr>
                <td>@cursada.Materia.Nombre</td>
                <td class="text-center">@cursada.AnioLectivo</td>
                <td class="text-center">@(cursada.Nota.HasValue ? cursada.Nota.Value.ToString("0.#") : "-")</td>
                <td class="text-center">@nombreEstado(cursada.Estado)</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="text-center text-muted">El estudiante no registra cursadas.</p>
}

<div class="text-end text-muted small">
    Generado el @DateTime.Now.ToString("dd/MM/yyyy") - @DateTime.Now.ToString("HH:mm")
</div>

@section Scripts {
    <script>
        window.print();
    </script>
}