@model AppAlumnos.Models.Cursada
<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">Cargar Notas</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="formNotas" asp-action="GuardarNotas" asp-controller="Cursadas" method="post"
      onsubmit="guardarNotas(event)">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label">Alumno</label>
            <input type="text" class="form-control" value="@ViewBag.AlumnoNombre" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">Materia</label>
            <input type="text" class="form-control" value="@ViewBag.MateriaNombre" disabled />
        </div>

        <div class="mb-3">
            <label asp-for="Nota" class="form-label"></label>
            <input asp-for="Nota" class="form-control" min="1" max="10" step="0.1" />
            <span asp-validation-for="Nota" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" asp-items="Html.GetEnumSelectList<AppAlumnos.Models.EstadoCursada>()"
                    class="form-select"></select>
            <span asp-validation-for="Estado" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Guardar Notas
        </button>
    </div>
</form>