@model AppAlumnos.Models.Cursada
<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">
        @(Model.Id == 0 ? "Nueva Inscripción" : "Editar Inscripción")
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="formCursada" asp-action="Guardar" asp-controller="Cursadas" method="post"
      onsubmit="guardarCursada(event)">
    @Html.AntiForgeryToken()
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="UsuarioId" class="form-label"></label>
            <select asp-for="UsuarioId" asp-items="ViewBag.Usuarios" class="form-select">
                <option value="">-- Seleccionar alumno --</option>
            </select>
            <span asp-validation-for="UsuarioId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MateriaId" class="form-label"></label>
            <select asp-for="MateriaId" asp-items="ViewBag.Materias" class="form-select">
                <option value="">-- Seleccionar materia --</option>
            </select>
            <span asp-validation-for="MateriaId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AnioLectivo" class="form-label"></label>
            <input asp-for="AnioLectivo" class="form-control" min="2000" max="2100" />
            <span asp-validation-for="AnioLectivo" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Inscribir
        </button>
    </div>
</form>