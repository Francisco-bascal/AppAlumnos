@model IEnumerable<AppAlumnos.Models.Materia>

@{
    ViewData["Title"] = "Gestión de Materias";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Materias</h2>
    <button type="button" class="btn btn-primary"
            onclick="abrirModal('@Url.Action("ObtenerFormulario", "Materias", new { id = 0 })')">
        + Nueva Materia
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                    <th>@Html.DisplayNameFor(model => model.Anio)</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle">@item.Nombre</td>
                        <td class="align-middle">@item.Anio° Año</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-warning me-1"
                                    onclick="abrirModal('@Url.Action("ObtenerFormulario", "Materias", new
                                    { id = item.Id })')">
                                Editar
                            </button>
                        <button class="btn btn-sm btn-outline-danger"
                                onclick="eliminarMateria(@item.Id, '@item.Nombre')">
                            Eliminar
                        </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Contenedor del Modal Bootstrap -->
<div class="modal fade" id="modalMateria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalContent">
            <!-- La parcial se cargará aquí vía AJAX -->
            <!-- Button trigger modal -->
            <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#exampleModal">
                Launch demo modal
            </button>

            <!-- Modal -->
            <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            ...
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-primary">Save changes</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const modalElement = new bootstrap.Modal(document.getElementById('modalMateria'));
        const modalContent = document.getElementById('modalContent');

        // 1. Abrir Modal para Crear/Editar
        function abrirModal(url) {
        fetch(url)
        .then(res => res.text())
        .then(html => {
        modalContent.innerHTML = html;
        // Re-bindear validaciones del lado del cliente de jQuery Validation
        $.validator.unobtrusive.parse('#formMateria');
        modalElement.show();
        });
        }

        // 2. Enviar Formulario vía AJAX
        function guardarMateria(event) {
        event.preventDefault();
        const form = event.target;

        
        if (!$(form).valid()) return; // Detener si hay errores de validación cliente

        fetch(form.action, {
        method: 'POST',
        body: new FormData(form)
        })
        .then(res => {
        // Si retorna JSON (Éxito)
        if (res.headers.get("content-type").includes("application/json")) {
        return res.json().then(data => {
        if (data.success) {
        modalElement.hide();
        location.reload(); // Recarga la tabla de datos
        }
        });
        }
        // Si retorna HTML (Error de validación del servidor -> Vuelve a dibujar el modal)
        else {
        return res.text().then(html => {
        modalContent.innerHTML = html;
        $.validator.unobtrusive.parse('#formMateria');
        });
        }
        });
        }

        // 3. Eliminar Registro vía AJAX
        function eliminarMateria(id, nombre) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: `¿Estás seguro de eliminar la materia "${nombre}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const formData = new FormData();
                    formData.append('id', id);
                    if(token) formData.append('__RequestVerificationToken', token);

                    fetch('@Url.Action("Eliminar", "Materias")', {
                        method: 'POST',
                        body: formData
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire(
                                '¡Eliminada!',
                                'La materia ha sido eliminada.',
                                'success'
                            ).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire(
                                'Error',
                                data.mensaje,
                                'error'
                            );
                        }
                    });
                }
            });
        }
    </script>
}